# Python
.venv/
__pycache__/
*.py[cod]

# 取得データ(再取得できる)
# - data/gsi/: mokuroku.csv.gz(75MB) と ZL16 タイル
# - data/jartic/: jartic-traffic-regulation-converter が出す GeoJSONL(全国 1.4GB)
# - data/areas/*/jartic_*.geojson: 04 が市域に切り出したもの
data/gsi/
data/jartic/
data/areas/*/jartic_*.geojson
# - data/areas/*/osm_highways.geojson: scripts/experiments/osm_road_class.py の Overpass キャッシュ
data/areas/*/osm_highways.geojson
# - data/areas/*/authorized_road/: 自治体の認定路線網図(shapefile)。areas/<key>.json の authorized_road.source から取る
data/areas/*/authorized_road/

# - data/n03/: 国土数値情報 N03 全国 zip(600MB)
# - data/areas/pref_*/boundary.geojson: N03 から make_pref_areas.py で再生成できる(47 県で 350MB)
data/n03/
data/areas/pref_*/boundary.geojson

# 中間生成物。集計表と判定図だけ残す(都道府県の判定図 47 枚 47MB は残さない)
out/*/*
!out/*/summary_*.csv
!out/*/final.png
out/pref_*/final.png
!out/national/prefectures.csv
!out/national/prefectures.md
out/*.log

# macOS
.DS_Store

# ビューワ(Vite)
viewer/node_modules/
viewer/dist/

# 測量成果使用承認書の原本(氏名・申請 ID を含むのでコミットしない)
docs/国地情使*.pdf
